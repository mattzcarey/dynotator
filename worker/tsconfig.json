{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "lib": ["ES2024"],
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": []
  },
  "include": [".", "../session", "../cloudflare.config.ts", "../.cloudflare/types/index.d.ts"],
  "exclude": ["../**/*.test.ts"]
}
