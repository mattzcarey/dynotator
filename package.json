{
  "name": "dynotator",
  "version": "0.1.0",
  "private": true,
  "description": "Human review of plans and markdown for agents on Cloudflare. A Worker with an RPC API; each review's server runs in a Dynamic Worker.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./worker/api.ts"
    }
  },
  "scripts": {
    "dev": "cf dev",
    "dev:self": "cf dev --mode self",
    "build": "cf build",
    "build:self": "cf build --mode self",
    "deploy": "cf deploy",
    "types": "cf workers types",
    "typecheck": "cf workers types && tsrs --noEmit -p tsconfig.json && tsrs --noEmit -p worker/tsconfig.json && tsrs --noEmit -p scripts/tsconfig.json",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun test",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun test"
  },
  "dependencies": {
    "@cloudflare/computer": "0.10.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@plannotator/web-highlighter": "^0.8.2",
    "dompurify": "^3.4.17",
    "marked": "^17.0.6",
    "mermaid": "12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "4.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.13",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "cf": "1.0.0-beta.28",
    "esbuild": "0.28.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tailwindcss": "^4.1.18",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "vite": "^7.3.8"
  }
}
