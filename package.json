{
  "name": "dynotator",
  "version": "0.1.0",
  "private": true,
  "description": "Plan review and annotation for coding agents, hosted on Cloudflare Workers. Each review session's server runs in a Dynamic Worker.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "bin": {
    "dynotator": "cli/index.ts"
  },
  "scripts": {
    "dev": "bun run build && wrangler dev",
    "dev:app": "vite",
    "build": "bun run build:session && bun run build:app",
    "build:app": "vite build",
    "build:session": "bun scripts/build-session.ts",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "tsrs --noEmit -p tsconfig.json && tsrs --noEmit -p worker/tsconfig.json && tsrs --noEmit -p cli/tsconfig.json",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun test",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@pierre/diffs": "1.5.2",
    "@plannotator/atomic-editor": "^0.9.0",
    "@plannotator/markdown-editor": "^0.5.0",
    "@plannotator/web-highlighter": "^0.8.2",
    "@plannotator/webtui": "0.1.0",
    "@tanstack/react-table": "^8.21.3",
    "@viz-js/viz": "3.31.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^8.0.4",
    "dompurify": "^3.4.17",
    "katex": "^0.19.0",
    "lucide-react": "^1.59.0",
    "marked": "^17.0.6",
    "mermaid": "12.2.0",
    "perfect-freehand": "^1.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "unique-username-generator": "^1.5.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "vite": "^6.2.0",
    "wrangler": "^4.159.0"
  }
}
