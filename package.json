{
  "name": "dynotator",
  "version": "0.1.0",
  "private": true,
  "description": "Human review of plans, documents and repositories for agents on Cloudflare. A Worker with an RPC API; each review's server runs in a Dynamic Worker.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./worker/api.ts"
    },
    "./worker": "./worker/index.ts",
    "./vite": "./scripts/build-session.ts"
  },
  "scripts": {
    "dev": "vp dev",
    "dev:self": "vp dev --mode self",
    "build": "vp build",
    "build:self": "vp build --mode self",
    "deploy": "cf deploy",
    "deploy:self": "cf deploy --mode self",
    "types": "cf workers types",
    "test": "vp test run",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "cf workers types && vp check && vp test run"
  },
  "dependencies": {
    "@cloudflare/computer": "0.10.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@plannotator/web-highlighter": "^0.8.2",
    "dompurify": "^3.4.17",
    "marked": "^17.0.6",
    "mermaid": "12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "4.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.13",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "cf": "1.0.0-beta.28",
    "esbuild": "0.28.2",
    "tailwindcss": "^4.1.18",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.1",
    "vite-plus": "1.5.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.1"
  }
}
